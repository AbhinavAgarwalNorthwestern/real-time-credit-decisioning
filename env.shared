# Non-secret shared environment variables for the project.
# Sourced by `direnv allow` (devcontainer) or `source env.shared` (manual).
# Secrets go in .env.local — do NOT commit .env.local.

# Project identifier
export PROJECT_NAME=real-time-ml-platform

# Kubernetes namespaces
export NS_MLFLOW=mlflow
export NS_KAFKA=kafka
export NS_RISINGWAVE=risingwave
export NS_CRYPTO=crypto
export NS_FINANCE=finance

# MLflow tracking server URI (port-forwarded locally; cluster-internal in K8s)
export MLFLOW_TRACKING_URI=http://localhost:5000

# RisingWave (Postgres-compatible)
export RW_HOST=localhost
export RW_PORT=4567
export RW_USER=root
export RW_DATABASE=dev

# Kafka broker (port-forwarded locally)
export KAFKA_BROKER_ADDRESS=localhost:31234

# AWS deployment defaults (used by Terraform + AWS overlay)
export AWS_REGION=us-east-1
export EKS_CLUSTER_NAME=real-time-ml-prod
export ECR_REGISTRY=

# Decision API target URL (local-kind ingress)
export DECIDE_URL=http://localhost:8080/decide
