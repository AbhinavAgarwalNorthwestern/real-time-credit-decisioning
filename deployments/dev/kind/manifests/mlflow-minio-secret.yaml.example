---
# Committed reference template — DO NOT put real credentials here.
# The real Secret is created from .env.local at the project root via:
#   bash scripts/create-mlflow-secret.sh
#
# The runtime file mlflow-minio-secret.yaml is gitignored.
apiVersion: v1
kind: Secret
metadata:
  name: mlflow-minio-secret
  namespace: mlflow
type: Opaque
stringData:
  AccessKeyID: REPLACE_WITH_REAL_ACCESS_KEY
  SecretKey: REPLACE_WITH_REAL_SECRET_KEY
